# ==============================================================================
# CardioVision AI - Environment Configuration Template
# Copy this file to .env before starting: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="CardioVision AI"
VERSION="1.0.0"

# Networking & Ports
PORT=8000
HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=80
HOST_PORT=80

# Database Configuration (Defaults to persistent SQLite inside container volume)
# For SQLite:
DATABASE_URL=sqlite:////app/data/cardiovision.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@db:5432/cardiovision

# Security & CORS (List explicit allowed domains; no wildcards)
# In production, replace localhost with your actual domain name:
ALLOWED_ORIGINS=["http://localhost","http://localhost:80","https://localhost","http://127.0.0.1","http://127.0.0.1:80"]

# Optional Shared Deployment Guard (Bearer token for API protection)
# Leave empty for public access / demo use:
API_TOKEN=

# Frontend API URL (Relative /api/v1 when behind Nginx reverse proxy)
VITE_API_BASE_URL=/api/v1

# Storage Paths
ARTIFACTS_DIR=/app/artifacts
MODEL_QUALITY_DIR=/app/artifacts/model_quality
