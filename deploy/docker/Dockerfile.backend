FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt backend/requirements.lock.txt /app/
# Retry the whole install for interrupted large wheel downloads. Keep pip's cache
# between attempts, then remove it so it does not enlarge the final image.
RUN for attempt in 1 2 3; do \
        pip install --timeout 120 --retries 10 -r requirements.lock.txt && break; \
        if [ "$attempt" -eq 3 ]; then exit 1; fi; \
        echo "Dependency download failed; retrying install ($attempt/3)..."; \
        sleep 5; \
    done \
    && pip check \
    && pip cache purge

# Copy application code and trained artifacts
COPY backend /app/backend
COPY artifacts/cardiovision_ensemble.joblib artifacts/heart_model_anatomy.json artifacts/benchmark_summary.json /app/artifacts/
COPY db/migrations /app/db/migrations
COPY alembic.ini /app/alembic.ini
RUN mkdir -p /app/data

EXPOSE 8000

ENV PYTHONPATH=/app
ENV PORT=8000
ENV AUTO_CREATE_TABLES=false
ENV PYTHONDONTWRITEBYTECODE=1
ENV MPLCONFIGDIR=/tmp/matplotlib

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 CMD curl --fail --silent http://127.0.0.1:8000/health || exit 1

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn backend.main:app --host 0.0.0.0 --port 8000 --no-access-log"]
